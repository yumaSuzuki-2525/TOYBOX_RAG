# ==============================
# プロジェクト固有の設定
# ==============================
.env
# public配下のディレクトリの中身を除外(ただしディレクトリ自体は維持)
public/docs/*
!public/docs/.gitkeep
public/processed/*
!public/processed/.gitkeep

*ignore*